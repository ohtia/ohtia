{
  "config": {
    "default": true,
    "line-length": false,
    "no-trailing-spaces": true,
    "no-duplicate-heading": {
      "siblings_only": true
    },
    "no-multiple-blanks": {
      "maximum": 1
    },
    "no-hard-tabs": true,
    "blanks-around-headings": {
      "lines_above": 1,
      "lines_below": 1
    },
    "blanks-around-lists": true,
    "list-marker-space": true,
    "ul-style": {
      "style": "dash"
    },
    "code-block-style": {
      "style": "fenced"
    },
    "fenced-code-language": true,
    "first-line-heading": true,
    "single-title": {
      "front_matter_title": ""
    }
  },
  "ignores": [
    "node_modules/**",
    ".venv/**",
    ".cache/**",
    "dist/**",
    "build/**",
    "out/**",
    "artifacts/**",
    "coverage/**",
    "tmp/**"
  ]
}
