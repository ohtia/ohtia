{
  "version": 1,
  "rules": [
    {
      "selector": ":root",
      "foreground": "content.primary",
      "backgrounds": ["surface.page"],
      "minimum": 7
    },
    {
      "selector": "button",
      "foreground": "content.primary",
      "backgrounds": ["surface.page"],
      "minimum": 7
    },
    {
      "selector": "button[aria-disabled=\"true\"]",
      "foreground": "content.disabled",
      "backgrounds": ["surface.page"],
      "minimum": 3
    },
    {
      "selector": ":focus-visible, [role=\"alert\"]:focus",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 3
    },
    {
      "selector": ".ohtia-brand",
      "foreground": "voice.ohtia.content",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 7
    },
    {
      "selector": ".language-save-state",
      "foreground": "content.secondary",
      "backgrounds": ["surface.page"],
      "minimum": 7
    },
    {
      "selector": ".language-danger",
      "foreground": "danger.content",
      "backgrounds": ["danger.surface"],
      "minimum": 7
    },
    {
      "selector": ".language-attention",
      "foreground": "attention.content",
      "backgrounds": ["attention.surface"],
      "minimum": 7
    },
    {
      "selector": ".primitive-primary",
      "backgrounds": ["action.primary.surface"],
      "minimum": 7,
      "foreground": "action.primary.content"
    },
    {
      "selector": ".primitive-destructive, .primitive-danger",
      "backgrounds": ["danger.surface"],
      "minimum": 7,
      "foreground": "danger.content"
    },
    {
      "selector": ".primitive-error, .primitive-attention",
      "backgrounds": ["attention.surface"],
      "minimum": 7,
      "foreground": "attention.content"
    },
    {
      "selector": ".primitive-link",
      "backgrounds": ["surface.page"],
      "minimum": 7,
      "foreground": "content.primary"
    },
    {
      "selector": ".primitive-field input, .primitive-field select",
      "backgrounds": ["surface.page"],
      "minimum": 7,
      "foreground": "content.primary"
    },
    {
      "selector": ".primitive-dialog, .primitive-tooltip, .primitive-popover, .primitive-menu",
      "backgrounds": ["surface.page"],
      "minimum": 7,
      "foreground": "content.primary"
    },
    {
      "selector": ".primitive-separator[aria-orientation=\"horizontal\"]",
      "backgrounds": ["surface.page"],
      "minimum": 3
    },
    {
      "selector": ".primitive-table-scroll thead th",
      "foreground": "content.primary",
      "backgrounds": ["surface.page"],
      "minimum": 7
    },
    {
      "selector": ".primitive-separator[aria-orientation=\"vertical\"]",
      "backgrounds": ["surface.page"],
      "minimum": 3
    },
    {
      "selector": ".primitive-primary:hover:not([aria-disabled=\"true\"])",
      "foreground": "action.primary.content",
      "backgrounds": ["action.primary.surface-hover"],
      "minimum": 7
    },
    {
      "selector": ".command-dialog .primitive-dialog-header > h2",
      "backgrounds": ["surface.page"],
      "minimum": 3,
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".command-dialog-footer",
      "backgrounds": ["surface.page"],
      "minimum": 3,
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".about-version",
      "backgrounds": ["surface.page"],
      "minimum": 3,
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".about-version dt",
      "foreground": "content.secondary",
      "backgrounds": ["surface.page"],
      "minimum": 7
    },
    {
      "selector": ".about-links a",
      "foreground": "content.primary",
      "backgrounds": ["surface.page"],
      "minimum": 7
    },
    {
      "selector": ".external-caption, .about-copied",
      "foreground": "content.secondary",
      "backgrounds": ["surface.page"],
      "minimum": 7
    },
    {
      "selector": ".command-danger",
      "foreground": "danger.content",
      "backgrounds": ["danger.surface"],
      "minimum": 7
    },
    {
      "selector": ".workspace",
      "backgrounds": ["surface.page"],
      "minimum": 7,
      "foreground": "content.primary"
    },
    {
      "selector": ".workspace-bar",
      "backgrounds": ["surface.panel"],
      "minimum": 7,
      "foreground": "content.primary"
    },
    {
      "selector": ".workspace-project-context",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 7,
      "foreground": "content.secondary",
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".workspace-panel-controls,\n.workspace-selector",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 3,
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".workspace-panel-controls button[aria-pressed=\"true\"]",
      "backgrounds": ["surface.emphasis"],
      "minimum": 7,
      "foreground": "content.primary"
    },
    {
      "selector": ".workspace-panel-controls button:not([aria-pressed=\"true\"])",
      "backgrounds": ["surface.panel"],
      "minimum": 7,
      "foreground": "content.primary",
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".workspace .workspace-primary",
      "backgrounds": ["action.primary.surface"],
      "minimum": 7,
      "foreground": "action.primary.content"
    },
    {
      "selector": ".workspace .workspace-primary[aria-disabled=\"true\"]",
      "backgrounds": ["surface.page"],
      "minimum": 3,
      "foreground": "content.disabled"
    },
    {
      "selector": ".workspace .workspace-zoom",
      "backgrounds": ["surface.panel"],
      "minimum": 7,
      "foreground": "content.secondary",
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".workspace[data-mode=\"narrow\"] .workspace-selector",
      "backgrounds": ["surface.emphasis"],
      "minimum": 7,
      "foreground": "content.secondary"
    },
    {
      "selector": ".workspace-selector button",
      "backgrounds": ["surface.emphasis"],
      "minimum": 7,
      "foreground": "content.secondary",
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".workspace-selector button[aria-pressed=\"true\"]",
      "backgrounds": ["surface.page"],
      "minimum": 7,
      "foreground": "content.primary"
    },
    {
      "selector": ".workspace-explorer,\n.workspace-chat,\n.workspace-rail",
      "backgrounds": ["surface.panel"],
      "minimum": 7,
      "foreground": "content.primary"
    },
    {
      "selector": ".workspace-panel-heading,\n.workspace-tabs",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 7,
      "foreground": "content.secondary",
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".workspace-empty",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 7,
      "foreground": "content.secondary"
    },
    {
      "selector": ".workspace-explorer-footer",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 3,
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".workspace kbd",
      "backgrounds": ["surface.page"],
      "minimum": 7,
      "foreground": "content.secondary",
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".workspace-splitter-line",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 3,
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".workspace-splitter:hover .workspace-splitter-line,\n.workspace-splitter:focus .workspace-splitter-line",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 3
    },
    {
      "selector": ".workspace[data-dragging=\"true\"] .workspace-splitter:focus .workspace-splitter-line",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 3
    },
    {
      "selector": ".workspace-grip",
      "backgrounds": ["surface.page"],
      "minimum": 7,
      "foreground": "content.secondary"
    },
    {
      "selector": ".workspace .primitive-tooltip",
      "backgrounds": ["action.primary.surface"],
      "minimum": 7,
      "foreground": "action.primary.content"
    },
    {
      "selector": ".workspace-skip",
      "backgrounds": ["surface.page"],
      "minimum": 7,
      "foreground": "content.primary"
    },
    {
      "selector": ".workspace-danger",
      "backgrounds": ["danger.surface"],
      "minimum": 7,
      "foreground": "danger.content"
    },
    {
      "selector": ".workspace-attention",
      "backgrounds": ["attention.surface"],
      "minimum": 7,
      "foreground": "attention.content"
    },
    {
      "selector": ".workspace-title-row",
      "backgrounds": ["surface.panel"],
      "minimum": 3,
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".workspace-documents > h2:focus + .workspace-tabs [role=\"tab\"]",
      "backgrounds": ["surface.page", "surface.panel"],
      "minimum": 3
    },
    {
      "selector": ".settings-dialog .primitive-dialog-header",
      "backgrounds": ["surface.page"],
      "minimum": 3,
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".settings-content section",
      "backgrounds": ["surface.page"],
      "minimum": 3,
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".settings-save-state, .settings-content small, .settings-info, .settings-zoom > p",
      "backgrounds": ["surface.page"],
      "minimum": 7,
      "foreground": "content.secondary"
    },
    {
      "selector": ".settings-theme-card",
      "backgrounds": ["surface.page"],
      "minimum": 3
    },
    {
      "selector": ".settings-theme-card[data-selected=\"true\"], .settings-character-option[data-selected=\"true\"]",
      "backgrounds": ["surface.page"],
      "minimum": 3
    },
    {
      "selector": ".settings-theme-preview",
      "backgrounds": ["surface.page"],
      "minimum": 3
    },
    {
      "selector": ".settings-character-preview",
      "backgrounds": ["surface.page"],
      "minimum": 3,
      "decorativeBorders": "border.subtle"
    },
    {
      "selector": ".settings-content input",
      "backgrounds": ["surface.page"],
      "minimum": 3
    },
    {
      "selector": ".settings-character-option[data-selected=\"true\"]",
      "backgrounds": ["surface.page"],
      "minimum": 7,
      "foreground": "content.primary"
    },
    {
      "selector": ".settings-content .language-danger, .settings-feedback .language-danger",
      "backgrounds": ["surface.page"],
      "minimum": 3
    },
    {
      "selector": ".settings-content .language-attention, .settings-feedback .language-attention",
      "backgrounds": ["surface.page"],
      "minimum": 3
    },
    {
      "selector": ".character-decoration",
      "foreground": "voice.ohtia.content",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 7
    },
    {
      "selector": ".voice-label",
      "foreground": "voice.ohtia.content",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 7
    },
    {
      "selector": ".voice-label[data-origin=\"human\"]",
      "foreground": "voice.tutor.content",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 7
    },
    {
      "selector": ".voice-label[data-origin=\"unknown\"]",
      "foreground": "content.primary",
      "backgrounds": ["surface.page", "surface.panel", "surface.emphasis"],
      "minimum": 7
    }
  ],
  "overlays": [
    {
      "selector": ".primitive-dialog::backdrop",
      "token": "overlay.scrim"
    }
  ]
}
