{
  "name": "@ohtia/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node ../../tooling/workspace.mjs lint",
    "format:check": "node ../../tooling/workspace.mjs format:check",
    "test": "node ../../tooling/workspace.mjs test"
  },
  "dependencies": {
    "@ohtia/contracts": "workspace:*",
    "@ohtia/domain": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
